# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# --- Database (Neon) ---
# Pooled connection (hostname contains -pooler) for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no -pooler) for drizzle migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Site ---
# Fallback for the sitemap and for emails sent with no browser request (a cron job).
# Links in emails sent while someone is on the site use that site's address instead.
# While testing, set this to https://camilleallen.ideaz.net. At launch, https://camilleallen.com.
APP_URL="https://camilleallen.com"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# Comma-separated emails that are promoted to admin when they sign in.
ADMIN_EMAILS="camille@camilleallen.com"

# --- Email via Ideaz ApiPro ---
# "ideaz" sends through the API; "outbox" only records emails in the email_log table (dev/testing).
EMAIL_TRANSPORT="ideaz"
IDEAZ_API_URL="https://api2.ideaz.net/email/"
IDEAZ_API_KEY=""
EMAIL_FROM="Camille Allen <camille@camilleallen.com>"
# Where new-order and contact notifications go (falls back to the store email setting).
ADMIN_NOTIFY_EMAIL=""

# --- PSiGate ---
# "test" uses PSiGate staging, "live" uses production, "simulate" fakes the charge (never allowed in production).
# Cards are charged through the Real-time XML API (live: https://realtime.psigate.com/xml).
PSIGATE_MODE="test"
# StoreID + Passphrase from the PSiGate welcome kit (the same ones the old WooCommerce PSiGate plugin used).
# The store's PSiGate CustomerID is camilleallenartistus; confirm with PSiGate that it is also the StoreID.
PSIGATE_STORE_ID="camilleallenartistus"
PSIGATE_PASSPHRASE=""
# Optional overrides if PSiGate gives you store-specific URLs
PSIGATE_XML_URL=""
PSIGATE_VERIFY_URL=""
# Saved cards recharge a previous PSiGate order via PreOrderID. Enable only after PSiGate confirms it for your store.
PSIGATE_SAVED_CARDS="false"

# --- Images (Vercel Blob). Without a token, uploads are stored in Postgres and served from /media. ---
BLOB_READ_WRITE_TOKEN=""

# --- Instagram (optional bootstrap token; can also be pasted in Admin > Settings) ---
INSTAGRAM_ACCESS_TOKEN=""

# --- Facebook Page (optional; a Page access token can also be pasted in Admin > Settings) ---
FACEBOOK_PAGE_ACCESS_TOKEN=""

# --- Cloudflare Turnstile (optional bot protection on public forms) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Vercel Cron ---
CRON_SECRET=""
